@page "/cart/confirmation"
@attribute [Authorize]

<PageTitle>Order Confirmed</PageTitle>

<div class="text-center">
    <h1 class="text-info pt-4">Congratulations!</h1>
    <p class="pb-3">We have received your order and your payment will be processed soon!</p>
    <img src="/images/order.PNG" width="80%" alt="Order confirmed"
         onerror="this.style.display='none'" />
    <div class="mt-4">
        <a href="/" class="btn btn-success">Continue Shopping</a>
    </div>
</div>
